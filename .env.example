# 複製成 .env 再改 / copy to .env and edit

# 名字（頁面和工具說明裡用）/ names shown on the page and in the tool descriptions
HUMAN_NAME=Alex
AI_NAME=Claude

# 時區：零點按這裡算 / windows open at midnight in this time zone (IANA name)
ADVENT_TZ=Asia/Tokyo
# 哪一年的 12 月（不寫 = 今年）/ which December (default: this year)
# ADVENT_YEAR=2026

# 屋簷上掃雪的小傢伙：star 小星星（預設）、crab 小螃蟹或 lynx 小猞猁（Doctor）
# ADVENT_SPRITE=crab

# 藏好以後零點前能改幾次；none = 不限 / changes allowed after hiding; "none" = unlimited
ADVENT_EDIT_LIMIT=1

# 兩把鑰匙。不寫的話第一次啟動自動生成，存在 data/keys.json
# Two keys. If unset, they're generated on first start and saved in data/keys.json
# HUMAN_KEY=
# AI_KEY=

# 監聽地址。放在反向代理（Caddy/Nginx）後面就保持 127.0.0.1
# Keep 127.0.0.1 behind a reverse proxy; 0.0.0.0 to reach it from your phone on the same Wi-Fi
HOST=127.0.0.1
PORT=8024

# 有人藏好/拆開/回答/提醒時 POST 一條 JSON 過去（不帶禮物內容），比如接進你們的聊天或 Telegram 機器人
# Optional: POST a small JSON here when someone hides/opens/answers/nudges (never the gift itself)
# ADVENT_WEBHOOK=https://example.com/hook

# 走 HTTPS 時給 cookie 加 Secure（反向代理會帶 X-Forwarded-Proto 的話不用設）
# COOKIE_SECURE=1

# 試玩：讓時鐘從某一刻開始走，看拆開的效果。正式用別設！
# Try it out: start the clock at a given moment. Never set this for real use!
# ADVENT_NOW=2026-12-05T20:00:00+09:00
