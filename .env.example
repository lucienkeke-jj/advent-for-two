# 复制成 .env 再改 / copy to .env and edit

# 名字（页面和工具说明里用）/ names shown on the page and in the tool descriptions
HUMAN_NAME=Alex
AI_NAME=Claude

# 时区：零点按这里算 / windows open at midnight in this time zone (IANA name)
ADVENT_TZ=Asia/Tokyo
# 哪一年的 12 月（不写 = 今年）/ which December (default: this year)
# ADVENT_YEAR=2026

# 屋檐上扫雪的小家伙：star 小星星（默认）或 crab 小螃蟹 / the little one on the roof: star (default) or crab
# ADVENT_SPRITE=crab

# 藏好以后零点前能改几次；none = 不限 / changes allowed after hiding; "none" = unlimited
ADVENT_EDIT_LIMIT=1

# 两把钥匙。不写的话第一次启动自动生成，存在 data/keys.json
# Two keys. If unset, they're generated on first start and saved in data/keys.json
# HUMAN_KEY=
# AI_KEY=

# 监听地址。放在反向代理（Caddy/Nginx）后面就保持 127.0.0.1
# Keep 127.0.0.1 behind a reverse proxy; 0.0.0.0 to reach it from your phone on the same Wi-Fi
HOST=127.0.0.1
PORT=8024

# 有人藏好/拆开/回答/提醒时 POST 一条 JSON 过去（不带礼物内容），比如接进你们的聊天或 Telegram 机器人
# Optional: POST a small JSON here when someone hides/opens/answers/nudges (never the gift itself)
# ADVENT_WEBHOOK=https://example.com/hook

# 走 HTTPS 时给 cookie 加 Secure（反向代理会带 X-Forwarded-Proto 的话不用设）
# COOKIE_SECURE=1

# 试玩：让时钟从某一刻开始走，看拆开的效果。正式用别设！
# Try it out: start the clock at a given moment. Never set this for real use!
# ADVENT_NOW=2026-12-05T20:00:00+09:00
